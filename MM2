-- ============================================================
--  MM2 ESP v2 | v-severe | ENI x LO
--  CORRECT roles: Tool:Knife = Murder, Tool:Gun = Sheriff
--  SMOOTH: 30fps position data + 60fps W2S in render
--  STABLE: pcall everything, pre-created Drawing pool
-- ============================================================
pcall(function() if _G._espStop then _G._espStop() end end)
task.wait(0.1)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local lp = Players.LocalPlayer
local cam = Workspace.CurrentCamera

local CFG = {
    textSize = 15, offsetY = -8, maxDist = 300,
    colorGun = Color3.fromRGB(30, 144, 255),
    colorKnife = Color3.fromRGB(255, 50, 50),
    colorInnocent = Color3.fromRGB(50, 200, 50),
    colorGunDrop = Color3.fromRGB(255, 215, 0),
    outlineClr = Color3.fromRGB(0, 0, 0),
}

local MAX = 20
local pool = {}
for i = 1, MAX do
    local t = Drawing.new("Text")
    t.Size = CFG.textSize; t.Center = true; t.Outline = true
    t.OutlineColor = CFG.outlineClr; t.ZIndex = 10; t.Visible = false
    pool[i] = t
end

local gdLabel = Drawing.new("Text")
gdLabel.Text = "Gun Drop"; gdLabel.Size = CFG.textSize; gdLabel.Center = true
gdLabel.Outline = true; gdLabel.OutlineColor = CFG.outlineClr
gdLabel.Color = CFG.colorGunDrop; gdLabel.ZIndex = 10; gdLabel.Visible = false

local espEntries = {}
local espCount = 0
local gdWorld = {active = false, wx = 0, wy = 0, wz = 0}
local running = true

local function dist3(a, b)
    local dx = a.X - b.X; local dy = a.Y - b.Y; local dz = a.Z - b.Z
    return math.sqrt(dx*dx + dy*dy + dz*dz)
end

local function detectRole(model)
    local ok, role = pcall(function()
        -- check character for Tool:Knife or Tool:Gun
        local knifeTool = model:FindFirstChild("Knife")
        local gunTool = model:FindFirstChild("Gun")
        if knifeTool and knifeTool.ClassName == "Tool" then return "knife" end
        if gunTool and gunTool.ClassName == "Tool" then return "gun" end
        -- check Backpack (weapon not equipped yet)
        local plr = Players:FindFirstChild(model.Name)
        if plr then
            local bp = plr:FindFirstChild("Backpack")
            if bp then
                local bk = bp:FindFirstChild("Knife")
                local bg = bp:FindFirstChild("Gun")
                if bk and bk.ClassName == "Tool" then return "knife" end
                if bg and bg.ClassName == "Tool" then return "gun" end
            end
        end
        -- HasWeapon but no tool visible = armed but unidentified
        if model:GetAttribute("HasWeapon") then return "armed" end
        return "innocent"
    end)
    return ok and role or "innocent"
end

local dataThread = task.spawn(function()
    local gdTimer = 0
    local gdCache = nil
    while running do
        local ok = pcall(function()
            local now = os.clock()
            local myPos = nil
            local mm = Workspace:FindFirstChild(lp.Name)
            if mm then
                local hr = mm:FindFirstChild("HumanoidRootPart")
                if hr then myPos = hr.Position end
            end
            if now - gdTimer >= 2 then
                gdTimer = now
                local gok, gr = pcall(function() return Workspace:FindFirstDescendant("GunDrop") end)
                gdCache = gok and gr or nil
            end
            if gdCache and gdCache.Parent then
                local dp = gdCache.Position
                if myPos and dist3(dp, myPos) > CFG.maxDist then
                    gdWorld.active = false
                else
                    gdWorld.active = true
                    gdWorld.wx = dp.X; gdWorld.wy = dp.Y; gdWorld.wz = dp.Z
                end
            else
                gdWorld.active = false
            end
            local ne = {}
            local c = 0
            for _, plr in ipairs(Players:GetChildren()) do
                if plr == lp then continue end
                if c >= MAX then break end
                local model = Workspace:FindFirstChild(plr.Name)
                if not model then continue end
                local head = model:FindFirstChild("Head")
                local hrp = model:FindFirstChild("HumanoidRootPart")
                local wpos = nil
                if head then wpos = head.Position + Vector3.new(0, 0.6, 0)
                elseif hrp then wpos = hrp.Position + Vector3.new(0, 3.5, 0) end
                if not wpos then continue end
                if myPos and dist3(wpos, myPos) > CFG.maxDist then continue end
                local role = detectRole(model)
                local color = CFG.colorInnocent; local tag = " [Innocent]"
                if role == "gun" then color = CFG.colorGun; tag = " [Sheriff]"
                elseif role == "knife" then color = CFG.colorKnife; tag = " [Murder]"
                elseif role == "armed" then color = CFG.colorGun; tag = " [Armed]" end
                c = c + 1
                ne[c] = { wx = wpos.X, wy = wpos.Y, wz = wpos.Z, text = plr.Name .. tag, color = color }
            end
            espEntries = ne
            espCount = c
        end)
        if not ok then task.wait(0.5) else task.wait(0.033) end
    end
end)

local renderConn = RunService.Render:Connect(function()
    if not cam then return end
    if gdWorld.active then
        local sv, vis = cam:WorldToScreenPoint(Vector3.new(gdWorld.wx, gdWorld.wy, gdWorld.wz))
        if vis then gdLabel.Visible = true; gdLabel.Position = Vector2.new(sv.X, sv.Y + CFG.offsetY)
        else gdLabel.Visible = false end
    else gdLabel.Visible = false end
    local n = espCount
    local ent = espEntries
    for i = 1, MAX do
        local lbl = pool[i]
        if i <= n and ent[i] then
            local d = ent[i]
            local sv, vis = cam:WorldToScreenPoint(Vector3.new(d.wx, d.wy, d.wz))
            if vis then
                lbl.Visible = true; lbl.Position = Vector2.new(sv.X, sv.Y + CFG.offsetY)
                lbl.Text = d.text; lbl.Color = d.color
            else lbl.Visible = false end
        else lbl.Visible = false end
    end
end)

_G._espStop = function()
    running = false
    pcall(function() renderConn:Disconnect() end)
    pcall(function() task.cancel(dataThread) end)
    for _, l in ipairs(pool) do pcall(function() l:Remove() end) end
    pcall(function() gdLabel:Remove() end)
    _G._espStop = nil
end

print("[ENI] MM2 ESP v2 loaded")
print("To stop: _G._espStop()")
